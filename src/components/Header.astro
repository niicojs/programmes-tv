---
import { formatDateFR } from '../lib/utils';

interface Props {
  date?: Date;
}

const { date = new Date() } = Astro.props;
const formattedDate = formatDateFR(date);
---

<header class="bg-linear-to-r from-slate-900 to-slate-800 text-white py-3 px-4">
  <div class="max-w-7xl mx-auto flex items-center justify-between">
    <h1 class="text-xl md:text-2xl font-bold">Ce soir</h1>
    <p class="text-sm md:text-base text-white/80">{formattedDate}</p>
  </div>
</header>
