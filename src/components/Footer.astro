---
import { formatTime, formatDateFR } from '../lib/utils';

interface Props {
  buildTime?: Date;
}

const { buildTime = new Date() } = Astro.props;
const formattedTime = formatTime(buildTime);
const formattedDate = formatDateFR(buildTime);
---

<footer class="bg-slate-900 text-white/70 py-6 px-4 text-center">
	<div class="max-w-6xl mx-auto">
		<p class="text-sm">
			Mise à jour : {formattedDate} à {formattedTime}
		</p>
	</div>
</footer>
