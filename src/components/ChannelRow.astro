---
import type { Channel, Programme } from '../lib/types';
import ProgramCard from './ProgramCard.astro';

interface Props {
  channel: Channel;
  programmes: Programme[];
}

const { channel, programmes } = Astro.props;
---

<section class="py-4 px-3 md:px-4 border-b border-gray-200 last:border-b-0">
  <div class="flex items-center gap-3 mb-4">
    {
      channel.icon ? (
        <img
          src={channel.icon}
          alt={channel.name}
          class="w-10 h-10 md:w-12 md:h-12 object-contain rounded-lg bg-white p-1 shadow-sm"
          loading="lazy"
        />
      ) : (
        <div class="w-10 h-10 md:w-12 md:h-12 flex items-center justify-center bg-linear-to-br from-slate-900 to-slate-800 text-white font-bold text-lg rounded-lg">
          {channel.name.charAt(0)}
        </div>
      )
    }
    <h2 class="text-lg md:text-xl font-semibold text-slate-900">{channel.name}</h2>
  </div>
  <div
    class="flex gap-2 overflow-x-auto pb-2 snap-x snap-mandatory scrollbar-thin scrollbar-thumb-gray-300 scrollbar-track-gray-100"
  >
    {programmes.map((prog) => <ProgramCard programme={prog} />)}
  </div>
</section>
